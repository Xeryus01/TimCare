###########################################################
# TimCare - Konfigurasi .env untuk cPanel (PRODUCTION)
#
# Dasar: env produksi cPanel (URL & konfigurasi server), sudah
# diselaraskan dengan konfigurasi aplikasi TERBARU:
#   - Mail: Gmail SMTP (aktif)
#   - WhatsApp: Fonnte (aktif)
#
# Langkah deploy di server cPanel:
#   1. Salin file ini menjadi ".env" di root aplikasi.
#   2. Pastikan kredensial DB MySQL sesuai (menu "MySQL Databases").
#   3. Jalankan:
#        php artisan config:clear
#        php artisan migrate --force
#        php artisan storage:link   (jika belum)
###########################################################

APP_NAME="TimCare ITSM Dashboard"
APP_ENV=production
APP_KEY=base64:nJHmBAO4QqhAEqOltXx+h5dzSG+BmH1rghjWCQE65Xw=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://digistat.web.bps.go.id/timcare

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Aplikasi berjalan pada subpath /timcare -> atur base aset & paksa HTTPS
VITE_BASE=/timcare/
ASSET_URL=https://digistat.web.bps.go.id/timcare
FORCE_HTTPS=true

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging (produksi: cukup level error)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==========================================================
# DATABASE - MySQL cPanel (WAJIB sesuaikan dengan akun Anda)
# ==========================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=digistat_timcare
DB_USERNAME=digistat_bps1900
DB_PASSWORD=bps19jaya

# ==========================================================
# SESSION & CACHE - gunakan database (cocok untuk shared hosting cPanel)
# ==========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_TABLE=sessions

# Tanpa queue worker (cPanel biasa): pengiriman notifikasi berjalan
# setelah respons HTTP (dispatchAfterResponse), jadi QUEUE tetap sync.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=
DB_CACHE_TABLE=cache

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================
# MAIL - Gmail SMTP (konfigurasi terbaru yang sudah berjalan)
# Catatan anti-spam: idealnya gunakan email domain resmi dengan
# SPF/DKIM/DMARC. Email dari Gmail pribadi lebih rentan masuk spam.
# ==========================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=kerjaby@gmail.com
MAIL_PASSWORD="guok rxfg npzg umac"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="kerjaby@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# WhatsApp Fonnte (konfigurasi terbaru yang sudah berjalan)
# Di cPanel produksi biarkan VERIFY_SSL=true (CA bundle tersedia),
# agar koneksi ke api.fonnte.com tetap aman.
# ==========================================================
WHATSAPP_ENABLED=true
WHATSAPP_FONNTE_URL=https://api.fonnte.com/send
WHATSAPP_FONNTE_KEY="4HroHKeJeviXERi33EQm"
WHATSAPP_SENDER_NUMBER=685111361900
WHATSAPP_VERIFY_SSL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Single Sign-On (Keycloak) configuration
SSO_URL=https://sso.bps.go.id
SSO_REALM=pegawai-bps
SSO_SCOPE="openid profile-pegawai"
SSO_CLIENT_ID=11900-timcare-h9f
SSO_CLIENT_SECRET=b2a78abe-ea01-4c99-8ed9-b1255d76d4a1
SSO_REDIRECT_URI=https://digistat.web.bps.go.id/timcare/sso/callback

# When false, public self-registration is hidden and manual account creation is admin-only
MANUAL_REGISTER_ENABLED=false
